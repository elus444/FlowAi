# Copy this to .env on the VM (next to docker-compose.prod.yml) and fill
# in real values. This file itself is never committed -- see .gitignore.

# Your VM's public IP with dots replaced by dashes, plus .sslip.io, e.g.
# 203.0.113.10 -> 203-0-113-10.sslip.io
# This gives Caddy a real hostname to get a Let's Encrypt cert for,
# without buying a domain. Swap in a real domain here later if you get one
# (and point its DNS A record at the VM's IP first).
DOMAIN=203-0-113-10.sslip.io

# Generate with: openssl rand -hex 32
SECRET_KEY=change-me-generate-a-real-random-secret

# Generate with: openssl rand -hex 20
POSTGRES_PASSWORD=change-me-generate-a-real-random-password

# LLM provider keys -- leave blank to deploy without them; the app fails
# clearly on generation requests rather than faking output. Add real keys
# whenever you have them and re-run `docker compose -f docker-compose.prod.yml up -d --build`.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
E2B_API_KEY=

MCP_ENABLED=false
