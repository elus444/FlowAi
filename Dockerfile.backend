FROM python:3.11-slim AS builder

WORKDIR /tmp
COPY backend/requirements.txt .

RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"
RUN pip install --upgrade pip && \
    pip install --no-cache-dir -r requirements.txt

FROM python:3.11-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PATH="/opt/venv/bin:$PATH"

RUN useradd -m -u 1000 appuser

WORKDIR /app

COPY --from=builder /opt/venv /opt/venv
COPY backend/ .

RUN chown -R appuser:appuser /app
USER appuser

# stdlib only ("requests" is not a direct project dependency). Binds to
# whatever port the process actually listens on (PORT if set).
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD sh -c 'python -c "import urllib.request as u; u.urlopen(\"http://localhost:${PORT:-8000}/health\", timeout=5)"'

# $PORT is injected by the platform (e.g. Railway); defaults to 8000 for
# local/docker-compose use.
CMD ["sh", "-c", "uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-8000}"]
